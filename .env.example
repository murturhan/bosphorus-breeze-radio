# Copy this file to .env and paste your YouTube stream key.
#
# YouTube Studio gives you an RTMP stream key for your live stream.
# Keep the real .env file private and never commit it to GitHub.
YOUTUBE_STREAM_KEY=replace_with_your_youtube_stream_key

# Optional: YouTube RTMP server URL.
# The default below is correct for most YouTube Live streams.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# Optional FFmpeg log level.
# Good beginner values: info, warning, error
FFMPEG_LOG_LEVEL=info

# Safe defaults for Oracle Cloud Free Tier VM.Standard.E2.1.Micro.
# These settings keep the stream light enough for a 1 OCPU / 1 GB RAM VPS.
# YouTube accepts this lower resolution; it is much safer than 1080p on this VM.
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_FPS=24
VIDEO_BITRATE=900k
VIDEO_MAXRATE=1100k
VIDEO_BUFSIZE=2200k
X264_PRESET=ultrafast
FFMPEG_THREADS=1

# Audio settings.
AUDIO_BITRATE=128k
AUDIO_RATE=44100
AUDIO_CHANNELS=2
